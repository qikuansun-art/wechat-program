/* pages/bill/bill.wxss —— 账单页样式（Tab） */

.page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* 顶部工具栏 */
.toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}
.toolbar-btn {
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFD6DE;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #FF6B81;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
}
.toolbar-btn:active {
  background: #FFF0F2;
}

/* 月份切换 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 8rpx;
  position: relative;
}
.month-arrow {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #666;
  background: #f7f7f7;
  border-radius: 50%;
}
.month-arrow:active {
  background: #ffe8ec;
  color: #FF6B81;
}
.month-text {
  min-width: 240rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}
.filter-clear {
  position: absolute;
  right: 24rpx;
  font-size: 24rpx;
  color: #FF6B81;
  background: #FFF0F2;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 未绑定提示 */
.bind-tip {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  background: #FFF7E6;
  border: 1rpx solid #FFE0A3;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.bind-tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.bind-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #B7791F;
}

/* 统计卡片 */
.stat-card {
  margin: 16rpx 24rpx;
  background: linear-gradient(135deg, #FF6B81 0%, #FF8E9F 100%);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.25);
}

.stat-card-head { display: flex; align-items: center; justify-content: space-between; }
.stat-budget-link { padding: 8rpx 0 8rpx 24rpx; font-size: 23rpx; color: rgba(255, 255, 255, .92); }
.stat-label {
  font-size: 26rpx;
  opacity: 0.9;
}
.stat-expense {
  font-size: 64rpx;
  font-weight: 700;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}
.stat-sub {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}
.stat-budget-row { margin-top: 30rpx; }
.stat-income-row { margin-top: 22rpx; }
.stat-value { margin-top: 6rpx; font-size: 30rpx; font-weight: 600; }
.stat-placeholder { color: rgba(255, 255, 255, .76); font-size: 27rpx; }
.stat-over { color: #FFF2B8; }
.stat-separator { height: 1rpx; margin-top: 24rpx; background: rgba(255, 255, 255, .22); }
.stat-error { margin-top: 20rpx; font-size: 22rpx; color: rgba(255, 255, 255, .82); }
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.stat-item-label {
  font-size: 24rpx;
  opacity: 0.85;
}
.stat-income {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 6rpx;
}
.stat-balance {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 6rpx;
}
.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.35);
  margin: 0 24rpx;
}

/* 维度切换 */
.dims {
  display: flex;
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
}
.dim-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666;
}
.dim-tab.active {
  color: #FF6B81;
  font-weight: 600;
  background: #FFF0F2;
}

/* 维度统计明细 */
.dim-panel {
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}
.dim-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.dim-name-wrap {
  width: 220rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.dim-name {
  font-size: 26rpx;
  color: #444;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dim-budget { margin-top: 4rpx; color: #999; font-size: 19rpx; line-height: 1.35; white-space: normal; }
.dim-track {
  flex: 1;
  height: 14rpx;
  background: #f5f5f5;
  border-radius: 7rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.dim-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B81, #FFA0AE);
  border-radius: 7rpx;
}
.dim-percent {
  width: 72rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}
.dim-amount {
  width: 150rpx;
  text-align: right;
  font-size: 24rpx;
  color: #666;
}

/* 筛选条 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.filter-chip {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #666;
}
.filter-chip.active {
  background: #FF6B81;
  color: #fff;
  border-color: #FF6B81;
}

/* 账单列表（左滑操作） */
.group {
  margin: 8rpx 24rpx;
}
.group-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
/* 左滑容器 */
.swipe-action {
  position: relative;
  overflow: hidden;
}
/* 背景操作按钮 */
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  z-index: 1;
}
.swipe-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}
.swipe-btn-edit {
  background: #5B8FF9;
}
.swipe-btn-del {
  background: #F0483E;
}
/* 内容层 */
.bill-item {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: #FFFFFF;
  transition: transform 0.3s ease;
  transform: translateX(0);
}
.bill-item:last-child {
  border-bottom: none;
}
.bill-item.swiped {
  transform: translateX(-280rpx);
}
.bill-date-col {
  width: 90rpx;
  flex-shrink: 0;
}
.bill-date {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}
.bill-info {
  flex: 1;
  min-width: 0;
}
.bill-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bill-matter {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 240rpx;
}
.bill-cat {
  font-size: 20rpx;
  color: #FF6B81;
  background: #FFF0F2;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.bill-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bill-creator {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}
.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.bill-amount.is-expense {
  color: #333;
}
.bill-amount.is-income {
  color: #FF6B81;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #666;
}
.empty-sub {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}
.list-footer, .list-error { padding: 24rpx; text-align: center; color: #aaa; font-size: 24rpx; }
.list-error { color: #FF6B81; }
.pagination-sentinel { height: 1px; }

/* 右下角固定记账按钮，位于原生 TabBar 上方 */
.add-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 20;
  height: 88rpx;
  padding: 0 34rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9F);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 129, 0.3);
}
.add-fab:active {
  opacity: 0.9;
}
