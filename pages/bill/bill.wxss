/* pages/bill/bill.wxss —— 账单页样式（Tab） */

.page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* 顶部工具栏 */
.toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}
.toolbar-btn {
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFD6DE;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #FF6B81;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
}
.toolbar-btn:active {
  background: #FFF0F2;
}

/* 未绑定提示 */
.bind-tip {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  background: #FFF7E6;
  border: 1rpx solid #FFE0A3;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.bind-tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.bind-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #B7791F;
}

/* 统计卡片 */
.month-summary-swiper { height: 376rpx; }
.stat-card {
  margin: 6rpx 24rpx;
  background: linear-gradient(135deg, #FF6B81 0%, #FF8E9F 100%);
  border-radius: 24rpx;
  padding: 12rpx 36rpx 17rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.25);
}

.stat-month-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 36rpx;
  margin-bottom: 2rpx;
}
.stat-month-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 36rpx;
  color: rgba(255, 255, 255, .72);
  font-size: 34rpx;
  font-weight: 400;
}
.stat-month-text { color: #fff; font-size: 28rpx; font-weight: 600; }
.stat-card-head { display: flex; align-items: center; justify-content: space-between; }
.stat-card-actions { display: flex; align-items: center; }
.stat-filter-clear {
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, .42);
  border-radius: 18rpx;
  color: rgba(255, 255, 255, .9);
  font-size: 20rpx;
}
.stat-budget-link { padding: 4rpx 0 4rpx 24rpx; font-size: 23rpx; color: rgba(255, 255, 255, .92); }
.stat-label {
  font-size: 26rpx;
  opacity: 0.9;
}
.stat-expense {
  font-size: 64rpx;
  font-weight: 700;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}
.stat-sub {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}
.stat-budget-row { margin-top: 14rpx; }
.stat-income-row { margin-top: 10rpx; }
.stat-value { margin-top: 4rpx; font-size: 30rpx; font-weight: 600; }
.stat-placeholder { color: rgba(255, 255, 255, .76); font-size: 27rpx; }
.stat-over { color: #FFF2B8; }
.stat-separator { height: 1rpx; margin-top: 10rpx; background: rgba(255, 255, 255, .22); }
.stat-error { margin-top: 20rpx; font-size: 22rpx; color: rgba(255, 255, 255, .82); }
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.stat-item-label {
  font-size: 24rpx;
  opacity: 0.85;
}
.stat-income {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 4rpx;
}
.stat-balance {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 4rpx;
}
.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.35);
  margin: 0 24rpx;
}

/* 红色汇总卡以下：统计 / 账单双 Sheet */
.bill-sheet-tabs {
  display: flex;
  margin: 22rpx 24rpx 10rpx;
  padding: 6rpx;
  background: #fff;
  border-radius: 24rpx;
}
.bill-sheet-tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #8c8c8c;
  font-size: 27rpx;
  font-weight: 500;
  transition: color .2s ease, background .2s ease;
}
.bill-sheet-tab.active {
  color: #ff607a;
  background: #fff0f3;
  font-weight: 600;
}
.bill-sheet-swiper { transition: height .2s ease; }
.bill-sheet-swiper.is-statistics { height: 814rpx; }
.bill-sheet-swiper.is-bills { height: 980rpx; }
.bill-sheet-scroll { height: 100%; }
.statistics-sheet-content { height: auto; }

.budget-progress-card {
  margin: 10rpx 24rpx 18rpx;
  padding: 10rpx 18rpx 8rpx;
  background: #fff;
  border-radius: 24rpx;
}
.budget-table-head {
  display: grid;
  grid-template-columns: 92rpx 92rpx minmax(0, 1fr) 150rpx;
  column-gap: 14rpx;
  align-items: center;
  min-height: 42rpx;
  color: #aaa;
  font-size: 20rpx;
}
.budget-table-head .budget-column,
.budget-table-head .budget-result-cell { font-size: 20rpx; }
.budget-progress-heading { display: flex; align-items: center; justify-content: space-between; }
.budget-legend { display: flex; align-items: center; color: #999; font-size: 18rpx; }
.legend-dot { width: 9rpx; height: 9rpx; margin: 0 3rpx 0 7rpx; border-radius: 50%; }
.legend-dot.mine { background: #6d9df5; }
.legend-dot.partner { background: #ff8faa; }
.sheet-loading { padding: 90rpx 0; text-align: center; color: #aaa; font-size: 24rpx; }
.sheet-error { color: #ff6b81; }
.budget-category-row {
  display: grid;
  grid-template-columns: 92rpx 92rpx minmax(0, 1fr) 150rpx;
  column-gap: 14rpx;
  align-items: center;
  min-height: 80rpx;
  padding: 4rpx 0;
  border-top: 1rpx solid #f5f5f5;
}
.budget-category-cell {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  overflow: hidden;
}
.budget-category-icon {
  width: 38rpx;
  flex-shrink: 0;
  font-size: 27rpx;
}
.budget-category-name { overflow: hidden; color: #4b4b4b; font-size: 24rpx; font-weight: 500; white-space: nowrap; }
.budget-column {
  min-width: 0;
  color: #777;
  font-size: 22rpx;
  text-align: left;
  white-space: nowrap;
}
.budget-progress-cell {
  min-width: 0;
}
.budget-progress-track {
  position: relative;
  display: flex;
  width: 100%;
  height: 14rpx;
  overflow: visible;
  background: #edf0f4;
  border-radius: 9rpx;
}
.budget-progress-segment { height: 14rpx; flex-shrink: 0; }
.segment-mine { background: #6d9df5; border-radius: 9rpx 0 0 9rpx; }
.segment-partner { background: #ff8faa; border-radius: 0 9rpx 9rpx 0; }
.budget-progress-values {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 5rpx;
  font-size: 22rpx;
  line-height: 1.15;
}
.mine-value { color: #5787df; }
.partner-value { color: #e87391; }
.budget-result-cell {
  min-width: 0;
  color: #9aa0a8;
  font-size: 22rpx;
  text-align: right;
  white-space: nowrap;
}
.over-value { color: #d93f56; font-weight: 600; }

/* 筛选条 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.filter-bar picker { flex-shrink: 0; }
.filter-chip {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #666;
}
.filter-chip.active {
  background: #FF6B81;
  color: #fff;
  border-color: #FF6B81;
}

/* 账单列表（左滑操作） */
.group {
  margin: 8rpx 24rpx;
}
.group-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
/* 左滑容器 */
.swipe-action {
  position: relative;
  overflow: hidden;
}
/* 背景操作按钮 */
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  z-index: 1;
}
.swipe-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}
.swipe-btn-edit {
  background: #5B8FF9;
}
.swipe-btn-del {
  background: #F0483E;
}
/* 内容层 */
.bill-item {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: #FFFFFF;
  transition: transform 0.3s ease;
  transform: translateX(0);
}
.bill-item:last-child {
  border-bottom: none;
}
.bill-item.swiped {
  transform: translateX(-280rpx);
}
.bill-date-col {
  width: 90rpx;
  flex-shrink: 0;
}
.bill-date {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}
.bill-info {
  flex: 1;
  min-width: 0;
}
.bill-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bill-matter {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 240rpx;
}
.bill-cat {
  font-size: 20rpx;
  color: #FF6B81;
  background: #FFF0F2;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.bill-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bill-creator {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}
.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.bill-amount.is-expense {
  color: #333;
}
.bill-amount.is-income {
  color: #FF6B81;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #666;
}
.empty-sub {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}
.list-footer, .list-error { padding: 24rpx; text-align: center; color: #aaa; font-size: 24rpx; }
.list-error { color: #FF6B81; }
.pagination-sentinel { height: 1px; }

/* 右下角固定记账按钮，位于原生 TabBar 上方 */
.add-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 20;
  height: 88rpx;
  padding: 0 34rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9F);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 129, 0.3);
}
.add-fab:active {
  opacity: 0.9;
}
