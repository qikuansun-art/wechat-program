/* pages/apply/apply.wxss —— 申请页样式 */

/* 邀请码卡片 */
.code-card {
  margin: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #FFF0F2, #FFFFFF);
  border: 2rpx solid #FFE3E8;
  border-radius: 24rpx;
  text-align: center;
}
.code-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}
.code-card-value {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: #FF6B81;
  margin: 24rpx 0;
}
.code-card-missing {
  color: #ccc;
  font-weight: 400;
  letter-spacing: 4rpx;
}
.code-card-btn {
  width: 80%;
  margin: 0 auto;
}
.code-card-tip {
  font-size: 22rpx;
  color: #B8BEC6;
  margin-top: 16rpx;
}

/* 未绑定引导 */
.unbind-guide {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE0A3;
  border-radius: 24rpx;
  text-align: center;
}
.unbind-guide-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}
.unbind-guide-text {
  font-size: 28rpx;
  color: #B7791F;
  display: block;
  margin-bottom: 24rpx;
}

/* 已绑定状态条 */
.bound-bar {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 32rpx;
  background: #FFF0F2;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}
.bound-bar-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.bound-bar-text {
  font-size: 26rpx;
  color: #FF6B81;
  flex: 1;
}

/* 表单 */
.form-card {
  margin-top: 8rpx;
}
.form-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 36rpx;
  color: #1F2329;
}
.duration-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.duration-input {
  flex: 1;
  background: #F7F8FA !important;
  color: #9AA0A6 !important;
}
.duration-unit {
  font-size: 28rpx;
  color: #9AA0A6;
  flex-shrink: 0;
}
.picker-row {
  display: flex;
  gap: 20rpx;
}
.picker-item {
  flex: 1;
}
.form-placeholder {
  color: #B8BEC6;
}
.textarea-count {
  text-align: right;
  font-size: 22rpx;
  color: #B8BEC6;
  margin-top: 8rpx;
}
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}
.image-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
}
.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.image-uploading {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
  text-align: center;
  padding: 8rpx 0;
  border-radius: 0 0 16rpx 16rpx;
}
.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #D8DCE1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFBFC;
}
.image-add-icon {
  font-size: 56rpx;
  color: #B8BEC6;
  line-height: 1;
}
.image-add-text {
  font-size: 22rpx;
  color: #9AA0A6;
  margin-top: 8rpx;
}
.form-tip {
  font-size: 22rpx;
  color: #B8BEC6;
  margin-top: 16rpx;
}