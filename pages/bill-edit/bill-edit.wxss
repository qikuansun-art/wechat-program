/* pages/bill-edit/bill-edit.wxss —— 记一笔样式 */

.page {
  min-height: 100vh;
  background: #fff;
  padding-bottom: 160rpx;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}
.page-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2329;
  padding: 32rpx 0 8rpx;
}

/* 类型切换 */
.type-tabs {
  display: flex;
  padding: 32rpx 0 8rpx;
}
.type-tab {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  color: #999;
  padding: 16rpx 0;
  position: relative;
}
.type-tab.active {
  color: #333;
  font-weight: 600;
}
.type-tab.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #FF6B81;
}

/* 金额输入 */
.amount-box {
  display: flex;
  align-items: baseline;
  padding: 32rpx 24rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f5f5f5;
}
.amount-symbol {
  font-size: 56rpx;
  font-weight: 600;
  color: #333;
  margin-right: 8rpx;
  flex-shrink: 0;
  line-height: 1.2;
}
.amount-input {
  font-size: 88rpx;
  font-weight: 700;
  color: #333;
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  text-align: left;
  padding: 0;
  margin: 0;
  display: block;
}
.amount-placeholder {
  color: #ddd;
  font-weight: 400;
}

/* 通用字段行 */
.field-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.field-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #888;
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 48rpx;
  line-height: 48rpx;
}
.field-placeholder {
  color: #ccc;
}
.field-value {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

/* 分类（Flex 自动换行） */
.cat-section {
  display: flex;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.cat-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #888;
  flex-shrink: 0;
  padding-top: 10rpx;
}
.cat-wrap {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  background: #f7f7f7;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #555;
}
.cat-item.active {
  background: #FF6B81;
  color: #fff;
}
.cat-item-icon {
  font-size: 28rpx;
}
.cat-item-name {
  font-size: 24rpx;
}

/* 记录人 */
.creator-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.creator-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #888;
  flex-shrink: 0;
}
.creator-name {
  font-size: 30rpx;
  color: #FF6B81;
  font-weight: 500;
}

/* 邀请码区域 */
.invite-section {
  margin: 24rpx 32rpx;
  padding: 28rpx 28rpx;
  background: #FFF5F7;
  border-radius: 20rpx;
  border: 1rpx solid #FFE0E6;
}
.invite-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.invite-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B81;
}
.invite-hint {
  font-size: 22rpx;
  color: #999;
}
.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.invite-code {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B81;
  letter-spacing: 8rpx;
  font-family: monospace;
}
.invite-copy-btn {
  font-size: 24rpx;
  color: #FF6B81;
  padding: 8rpx 24rpx;
  border: 1rpx solid #FF6B81;
  border-radius: 28rpx;
}

/* 保存按钮 */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.save-btn {
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9F);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 129, 0.3);
}
.save-btn:active {
  opacity: 0.9;
}