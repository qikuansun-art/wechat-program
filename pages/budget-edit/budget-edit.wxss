.page { padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }
.month-title { margin: 8rpx 4rpx 24rpx; font-size: 36rpx; font-weight: 650; color: #333; }
.copy-previous-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  margin: -8rpx 4rpx 18rpx;
  padding: 0 20rpx;
  border: 1rpx solid #ffd2da;
  border-radius: 29rpx;
  background: #fff5f7;
  color: #e85f78;
  font-size: 23rpx;
  line-height: 58rpx;
}
.copy-previous-btn::after { border: none; }
.card { margin-bottom: 22rpx; padding: 28rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 6rpx 20rpx rgba(86, 67, 72, .06); }
.section-title { margin-bottom: 20rpx; font-size: 29rpx; font-weight: 600; color: #333; }
.section-title text { margin-left: 8rpx; font-size: 22rpx; font-weight: 400; color: #aaa; }
.money-input, .category-input { display: flex; align-items: center; background: #fafafa; border: 1rpx solid #eee; border-radius: 16rpx; }
.money-input { height: 92rpx; padding: 0 24rpx; font-size: 34rpx; }
.money-input input { flex: 1; height: 100%; margin-left: 16rpx; font-size: 34rpx; }
.category-row { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f4f4f4; }
.category-row:last-child { border-bottom: none; }
.category-name { display: flex; align-items: center; gap: 12rpx; font-size: 27rpx; color: #444; }
.category-input { width: 250rpx; height: 62rpx; padding: 0 18rpx; font-size: 24rpx; }
.category-input input { flex: 1; height: 100%; margin-left: 8rpx; text-align: right; font-size: 25rpx; }
.save-btn { height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 32rpx; color: #fff; font-size: 30rpx; font-weight: 600; background: linear-gradient(135deg, #FF6B81, #FF8E9F); border-radius: 44rpx; }
.save-btn::after { border: none; }
