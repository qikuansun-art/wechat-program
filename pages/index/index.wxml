<!-- pages/index/index.wxml —— 首页：滚动 Banner + 功能模块 -->
<view class="page">

  <!-- ====== 顶部滚动 Banner ====== -->
  <view class="banner-wrap">
    <swiper class="banner-swiper" indicator-dots="{{bannerUrls.length > 1}}" indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#FF6B81" autoplay="{{bannerUrls.length > 1}}" interval="3500" duration="300"
      circular="{{bannerUrls.length > 1}}" bindchange="onBannerChange">
      <swiper-item wx:for="{{bannerUrls}}" wx:key="*this">
        <image class="banner-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewBanner" data-idx="{{index}}" binderror="onBannerImgError" />
      </swiper-item>
      <swiper-item wx:if="{{banners.length === 0}}">
        <view class="banner-empty">
          <text class="banner-empty-icon">📸</text>
          <text class="banner-empty-text">点击下方按钮添加轮播图</text>
        </view>
      </swiper-item>
      <swiper-item wx:if="{{bannerLoadFailed && banners.length > 0}}">
        <view class="banner-empty">
          <text class="banner-empty-text">图片暂时无法加载，请稍后重试</text>
        </view>
      </swiper-item>
    </swiper>
    <view class="banner-counter" wx:if="{{bannerUrls.length > 1}}">{{bannerCurrent + 1}}/{{bannerUrls.length}}</view>
    <view class="banner-actions">
      <view class="banner-action-btn" bindtap="onAddBanner" wx:if="{{!uploading}}">+ 添加图片</view>
      <view class="banner-action-btn" wx:if="{{banners.length > 0}}" bindtap="onManageBanners">管理</view>
    </view>
  </view>

  <!-- ====== Banner 管理弹层 ====== -->
  <view class="banner-manage-mask" wx:if="{{showBannerManage}}" bindtap="onManageMaskTap">
    <view class="banner-manage-panel" catchtap="onCloseManage">
      <view class="manage-header">
        <text class="manage-title">轮播图管理 ({{manageBanners.length}}/10)</text>
        <text class="manage-close" bindtap="onCloseManage">✕</text>
      </view>
      <scroll-view scroll-y class="manage-list">
        <view class="manage-item" wx:for="{{manageBanners}}" wx:key="*this">
          <image class="manage-thumb" src="{{manageBannerUrls[index] || item}}" mode="aspectFill" bindtap="onPreviewBanner" data-idx="{{index}}" />
          <view class="manage-item-info">
            <text class="manage-item-label">第 {{index + 1}} 张</text>
          </view>
          <view class="manage-item-btns">
            <view class="manage-btn manage-btn-up" wx:if="{{index > 0}}" bindtap="onManageMoveUp" data-idx="{{index}}">↑</view>
            <view class="manage-btn manage-btn-down" wx:if="{{index < manageBanners.length - 1}}" bindtap="onManageMoveDown" data-idx="{{index}}">↓</view>
            <view class="manage-btn manage-btn-del" bindtap="onManageDelete" data-idx="{{index}}">删除</view>
          </view>
        </view>
      </scroll-view>
      <view class="manage-footer">
        <view class="manage-add-btn" bindtap="onAddBanner" wx:if="{{manageBanners.length < 10}}">+ 继续添加</view>
      </view>
    </view>
  </view>

  <!-- ====== 快速入口 ====== -->
  <view class="home-card quick-card">
    <view class="home-card-title">快速入口</view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goScheduleCreate" hover-class="quick-hover">
        <view class="quick-icon-bubble pink">
          <view class="quick-icon schedule-icon"><view class="icon-highlight"></view><view class="calendar-line"></view><view class="calendar-heart"></view></view>
          <view class="cute-spark one"></view><view class="cute-spark two"></view>
        </view>
        <text class="quick-label">新建日程</text>
      </view>
      <view class="quick-item" bindtap="goApply" hover-class="quick-hover">
        <view class="quick-icon-bubble blue">
          <view class="quick-icon report-icon"><view class="clipboard-clip"></view><view class="icon-highlight"></view><view class="report-line one"></view><view class="report-line two"></view><view class="report-line three"></view><view class="paper-plane"><view class="paper-wing"></view></view></view>
          <view class="cute-spark one"></view><view class="cute-spark two"></view>
        </view>
        <text class="quick-label">发起报备</text>
      </view>
      <view class="quick-item" bindtap="goBill" hover-class="quick-hover">
        <view class="quick-icon-bubble yellow">
          <view class="wallet-icon"><view class="wallet-highlight"></view><view class="wallet-pocket"><view class="wallet-button"></view></view><view class="wallet-heart"></view><view class="wallet-coin coin-one"></view><view class="wallet-coin coin-two"></view></view>
          <view class="cute-spark one"></view><view class="cute-spark two"></view>
        </view>
        <text class="quick-label">记一笔</text>
      </view>
    </view>
  </view>

  <view class="home-card bind-card" wx:if="{{!bound && !loading}}" bindtap="goBind">
    <text class="bind-title">绑定伴侣后查看共同安排</text>
    <text class="bind-action">去绑定 ›</text>
  </view>

  <!-- ====== 今日安排 ====== -->
  <view class="home-card today-card" wx:if="{{bound}}">
    <view class="section-header">
      <view class="section-heading"><text>今日安排</text><text class="section-count" wx:if="{{todayScheduleTotal}}">{{todayScheduleTotal}}项</text></view>
      <view class="section-link" bindtap="goScheduleAll">查看全部 ›</view>
    </view>
    <view class="module-state" wx:if="{{todayScheduleLoading && todaySchedules.length === 0}}">正在加载...</view>
    <view class="module-state error" wx:elif="{{todayScheduleError}}" bindtap="retryTodaySchedules">今日安排暂时加载失败 · 点击重试</view>
    <view class="module-state" wx:elif="{{todaySchedules.length === 0}}">
      <text>今天还没有安排</text><text class="inline-action" bindtap="goScheduleCreate">新建日程</text>
    </view>
    <view class="today-list" wx:else>
      <view class="today-item" wx:for="{{todaySchedules}}" wx:key="instanceKey" bindtap="goScheduleDetail" data-id="{{item.id}}">
        <text class="owner-tag {{item.ownerClass}}">{{item.ownerLabel}}</text>
        <text class="today-time">{{item.timeText}}</text>
        <view class="today-main">
          <text class="today-title">{{item.title}}</text>
          <text class="today-state {{item.completed ? 'completed' : ''}}" wx:if="{{item.stateText}}">{{item.stateText}}</text>
        </view>
        <text class="type-tag {{item.typeClass}}">{{item.typeText}}</text>
        <view class="today-toggle {{item.typeClass}} {{item.completed ? 'checked' : ''}} {{item.toggling ? 'loading' : ''}}"
          data-instance-key="{{item.instanceKey}}" data-schedule-id="{{item.scheduleId}}" data-occurrence-date="{{item.occurrenceDate}}"
          data-completed="{{item.completed}}" catchtap="onTodayToggle">
          <view class="today-schedule-icon" wx:if="{{item.typeClass === 'schedule'}}"><view class="today-calendar-line"></view><view class="today-checkmark"></view></view>
          <view class="today-todo-icon" wx:elif="{{item.typeClass === 'todo'}}"><view class="today-checkmark"></view></view>
          <view class="today-checkin-icon" wx:else><view class="today-checkin-dot"></view><view class="today-checkmark"></view></view>
        </view>
      </view>
      <view class="more-row" wx:if="{{todayScheduleHasMore}}" bindtap="goScheduleAll">查看全部 ›</view>
    </view>
  </view>

  <!-- ====== 待审批列表 ====== -->
  <view class="home-card pending-card" wx:if="{{bound}}">
    <view class="section-header">
      <view class="section-heading"><text>待审批报备</text><text class="pending-count" wx:if="{{pendingReports.length}}">{{pendingReports.length}}</text></view>
    </view>
    <view class="module-state" wx:if="{{pendingLoading && pendingReports.length === 0}}">正在加载...</view>
    <view class="module-state error" wx:elif="{{pendingError}}" bindtap="retryPendingReports">待审批暂时加载失败 · 点击重试</view>
    <view class="module-state" wx:elif="{{pendingReports.length === 0}}">暂无待审批报备</view>
    <view class="pending-list">
      <view class="pending-item" wx:for="{{pendingReports}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="pending-left">
          <view class="pending-location">{{item.location || '未填写地点'}}</view>
          <view class="pending-meta">
            <text class="pending-creator">{{item.creatorName}} 发起</text>
            <text class="pending-time">{{item.createdAtText}}</text>
          </view>
        </view>
        <view class="status-tag pending">待审批</view>
      </view>
    </view>
  </view>

  <!-- ====== 最近报备 ====== -->
  <view class="home-card pending-card" wx:if="{{bound && latestReports.length > 0}}">
    <view class="section-header"><view class="section-heading">最近报备</view></view>
    <view class="pending-list">
      <view class="pending-item" wx:for="{{latestReports}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="pending-left">
          <view class="pending-location">{{item.reason || '未填写事由'}}</view>
          <view class="pending-meta">
            <text class="pending-time">{{item.createdAtText}}</text>
          </view>
        </view>
        <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
      </view>
    </view>
  </view>

  <!-- ====== 已绑定状态条（业务内容底部） ====== -->
  <view class="bound-bar" wx:if="{{bound && !loading}}">
    <text class="bound-bar-icon">❤</text>
    <text class="bound-bar-text">已绑定 {{partnerName}} · 发起报备后 TA 会收到提醒</text>
  </view>

  <view class="page-bottom"></view>
</view>
