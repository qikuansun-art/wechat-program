/* pages/index/index.wxss —— 首页样式：Banner + 功能模块 */

/* ====== Banner 轮播 ====== */
.banner-wrap {
  position: relative;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F7F8FA;
}
.banner-swiper {
  width: 100%;
  height: 320rpx;
}
.banner-img {
  width: 100%;
  height: 320rpx;
  display: block;
}
.banner-empty {
  width: 100%;
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F7F8FA;
}
.banner-empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.banner-empty-text {
  font-size: 26rpx;
  color: #B8BEC6;
}
.banner-actions {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  gap: 12rpx;
  z-index: 10;
}
.banner-action-btn {
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.banner-action-btn:active {
  background: rgba(0, 0, 0, 0.65);
}
.banner-counter {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  z-index: 10;
}

/* ====== 功能模块网格 ====== */
.module-grid {
  margin: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.module-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.05);
}
.card-hover {
  opacity: 0.85;
}
.module-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.module-icon-bill {
  background: #FF6B81;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 129, 0.3);
}
.module-icon-apply {
  background: #5B8FF9;
  box-shadow: 0 6rpx 16rpx rgba(91, 143, 249, 0.3);
}
.module-icon-invite {
  background: #FFB347;
  box-shadow: 0 6rpx 16rpx rgba(255, 179, 71, 0.3);
}
.module-info {
  flex: 1;
  min-width: 0;
}
.module-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}
.module-desc {
  font-size: 24rpx;
  color: #9AA0A6;
  margin-top: 4rpx;
}
.module-expense {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.module-expense-label {
  font-size: 20rpx;
  color: #9AA0A6;
}
.module-expense-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B81;
  margin-top: 2rpx;
}
.module-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}
.module-invite {
  border: 2rpx solid #FFE3A8;
}

/* ====== 已绑定状态条 ====== */
.bound-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 20rpx 24rpx;
  background: #FFF0F2;
  border-radius: 16rpx;
}
.bound-bar-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
}
.bound-bar-text {
  font-size: 24rpx;
  color: #FF6B81;
  flex: 1;
}

/* ====== 最近报备 ====== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
  margin-bottom: 20rpx;
}
.report-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.report-mini:active {
  opacity: 0.7;
}
.report-mini-left {
  flex: 1;
  min-width: 0;
}
.report-mini-location {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.report-mini-time {
  font-size: 24rpx;
  color: #9AA0A6;
  margin-top: 6rpx;
}

/* ====== 待审批列表 ====== */
.pending-card {
  margin-top: 0;
}
.pending-count {
  display: inline-block;
  background: #F0483E;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.pending-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.pending-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #FFF8F9;
  border-radius: 16rpx;
  border: 1rpx solid #FFE8EA;
}
.pending-item:active {
  opacity: 0.7;
}
.pending-left {
  flex: 1;
  min-width: 0;
}
.pending-location {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pending-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.pending-creator {
  font-size: 24rpx;
  color: #FF6B81;
}
.pending-time {
  font-size: 24rpx;
  color: #9AA0A6;
}

/* ====== Banner 管理弹层 ====== */
.banner-manage-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.banner-manage-panel {
  width: 100%;
  max-height: 75vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.manage-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F0F1F3;
}
.manage-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}
.manage-close {
  font-size: 36rpx;
  color: #9AA0A6;
  padding: 8rpx;
}
.manage-list {
  flex: 1;
  max-height: 55vh;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}
.manage-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F6F7;
}
.manage-item:last-child {
  border-bottom: none;
}
.manage-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F1F3;
}
.manage-item-info {
  flex: 1;
  margin-left: 20rpx;
}
.manage-item-label {
  font-size: 28rpx;
  color: #1F2329;
}
.manage-item-btns {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.manage-btn {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.manage-btn:active {
  opacity: 0.7;
}
.manage-btn-up,
.manage-btn-down {
  background: #F0F1F3;
  color: #5B8FF9;
  font-weight: 600;
}
.manage-btn-del {
  background: #FFF0F2;
  color: #F0483E;
}
.manage-footer {
  padding: 20rpx 32rpx 24rpx;
  border-top: 1rpx solid #F0F1F3;
}
.manage-add-btn {
  text-align: center;
  padding: 20rpx 0;
  background: #FF6B81;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.manage-add-btn:active {
  opacity: 0.85;
}