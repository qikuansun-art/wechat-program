/* pages/index/index.wxss —— 首页样式：Banner + 功能模块 */

/* ====== Banner 轮播 ====== */
.banner-wrap {
  position: relative;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F7F8FA;
}
.banner-swiper {
  width: 100%;
  height: 320rpx;
}
.banner-img {
  width: 100%;
  height: 320rpx;
  display: block;
}
.banner-empty {
  width: 100%;
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F7F8FA;
}
.banner-empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.banner-empty-text {
  font-size: 26rpx;
  color: #B8BEC6;
}
.banner-actions {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  gap: 12rpx;
  z-index: 10;
}
.banner-action-btn {
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.banner-action-btn:active {
  background: rgba(0, 0, 0, 0.65);
}
.banner-counter {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  z-index: 10;
}

/* ====== 首页轻量卡片与快速入口 ====== */
.home-card { margin: 20rpx 24rpx 0; padding: 26rpx 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(31, 35, 41, .05); }
.home-card-title, .section-heading { color: #1F2329; font-size: 30rpx; font-weight: 650; }
.quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 22rpx; }
.quick-item { min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 8rpx 4rpx; }
.quick-item + .quick-item { border-left: 1rpx solid #F0F1F3; }
.quick-hover { opacity: .72; }
.quick-label { margin-top: 12rpx; color: #3A3F46; font-size: 25rpx; white-space: nowrap; }
.quick-icon-bubble { position: relative; width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 34rpx; box-shadow: inset 0 3rpx 3rpx rgba(255,255,255,.75), 0 7rpx 15rpx rgba(80,60,75,.11); }
.quick-icon-bubble.pink { background: linear-gradient(145deg, #FFF8FA, #FFE3EA); }
.quick-icon-bubble.blue { background: linear-gradient(145deg, #F8FAFF, #DFE8FF); }
.quick-icon-bubble.yellow { background: linear-gradient(145deg, #FFFBEF, #FFE8B9); }
.quick-icon { position: relative; width: 64rpx; height: 64rpx; box-sizing: border-box; border-radius: 19rpx; }
.icon-highlight, .wallet-highlight { position: absolute; left: 8rpx; top: 6rpx; width: 27rpx; height: 8rpx; border-radius: 50%; background: rgba(255,255,255,.55); transform: rotate(-12deg); }
.cute-spark { position: absolute; width: 6rpx; height: 6rpx; border-radius: 50%; opacity: .55; }
.cute-spark.one { left: 7rpx; top: 22rpx; }
.cute-spark.two { right: 7rpx; bottom: 20rpx; width: 4rpx; height: 4rpx; }
.pink .cute-spark { background: #FF7C92; }
.blue .cute-spark { background: #7889DC; }
.yellow .cute-spark { background: #D8902C; }
.schedule-icon { border: 3rpx solid #EA6079; background: linear-gradient(160deg, #FF8BA0 0 29%, #FFF7F9 30% 100%); box-shadow: inset 0 -5rpx 8rpx rgba(246,157,174,.18), 0 6rpx 9rpx rgba(220,73,103,.2); }
.schedule-icon::before, .schedule-icon::after { content: ''; position: absolute; top: -7rpx; width: 9rpx; height: 18rpx; border: 3rpx solid #E65370; border-radius: 8rpx; background: #FFD5DE; box-sizing: border-box; box-shadow: inset 2rpx 2rpx 2rpx rgba(255,255,255,.7); }
.schedule-icon::before { left: 12rpx; }
.schedule-icon::after { right: 12rpx; }
.calendar-line { position: absolute; left: 7rpx; right: 7rpx; top: 21rpx; height: 3rpx; border-radius: 2rpx; background: rgba(228,91,118,.35); }
.calendar-heart { position: absolute; left: 50%; top: 43rpx; width: 17rpx; height: 17rpx; border-radius: 4rpx 3rpx 5rpx 3rpx; background: linear-gradient(135deg, #FF91A5, #F25372); box-shadow: 0 3rpx 5rpx rgba(218,67,96,.22); transform: translate(-50%,-50%) rotate(-45deg); }
.calendar-heart::before, .calendar-heart::after { content: ''; position: absolute; width: 17rpx; height: 17rpx; border-radius: 50%; background: inherit; }
.calendar-heart::before { left: 0; top: -8rpx; }
.calendar-heart::after { left: 8rpx; top: 0; }
.report-icon { border: 3rpx solid #697ACB; background: linear-gradient(145deg, #9FB8FF, #748CE2); box-shadow: inset 0 3rpx 4rpx rgba(255,255,255,.35), 0 6rpx 10rpx rgba(75,91,176,.23); transform: rotate(-2deg); }
.clipboard-clip { position: absolute; left: 50%; top: -6rpx; width: 28rpx; height: 13rpx; border: 3rpx solid #5E6FC2; border-radius: 9rpx; background: #DCE4FF; box-sizing: border-box; transform: translateX(-50%); }
.report-line { position: absolute; left: 12rpx; height: 4rpx; border-radius: 3rpx; background: rgba(255,255,255,.83); box-shadow: 0 2rpx 2rpx rgba(69,82,159,.12); }
.report-line.one { top: 20rpx; width: 35rpx; }
.report-line.two { top: 33rpx; width: 29rpx; }
.report-line.three { top: 46rpx; width: 21rpx; }
.paper-plane { position: absolute; right: -10rpx; bottom: -4rpx; width: 30rpx; height: 25rpx; border-radius: 5rpx 15rpx 5rpx 10rpx; background: linear-gradient(145deg, #FFFFFF, #DDE6FF); box-shadow: 0 5rpx 7rpx rgba(67,80,159,.25); transform: rotate(-13deg) skew(-8deg); }
.paper-wing { position: absolute; left: 7rpx; top: 8rpx; width: 14rpx; height: 9rpx; border-left: 3rpx solid #7181D8; border-bottom: 3rpx solid #7181D8; transform: skew(-20deg); }
.wallet-icon { position: relative; width: 68rpx; height: 54rpx; margin-top: 9rpx; border: 3rpx solid #D38320; border-radius: 18rpx 20rpx 17rpx 17rpx; box-sizing: border-box; background: linear-gradient(150deg, #FFC75F, #F19A2D); box-shadow: inset 0 4rpx 5rpx rgba(255,255,255,.35), inset 0 -5rpx 7rpx rgba(190,100,14,.13), 0 7rpx 10rpx rgba(184,103,16,.22); }
.wallet-pocket { position: absolute; right: -5rpx; top: 18rpx; width: 31rpx; height: 24rpx; border: 3rpx solid #C9791A; border-radius: 10rpx 5rpx 5rpx 10rpx; background: #FFDC89; box-sizing: border-box; }
.wallet-button { position: absolute; left: 7rpx; top: 6rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #C9791A; box-shadow: inset 1rpx 1rpx 2rpx rgba(255,255,255,.4); }
.wallet-coin { position: absolute; top: -17rpx; width: 24rpx; height: 24rpx; border: 3rpx solid #D18A21; border-radius: 50%; box-sizing: border-box; background: linear-gradient(145deg, #FFF1A4, #FFC543); box-shadow: inset 3rpx 3rpx 3rpx rgba(255,255,255,.5), 0 3rpx 5rpx rgba(172,98,15,.2); }
.coin-one { left: 8rpx; }
.coin-two { left: 27rpx; top: -13rpx; transform: scale(.82); }
.wallet-heart { position: absolute; left: 14rpx; top: 28rpx; width: 9rpx; height: 9rpx; border-radius: 2rpx; background: #F27770; transform: rotate(-45deg); }
.wallet-heart::before, .wallet-heart::after { content: ''; position: absolute; width: 9rpx; height: 9rpx; border-radius: 50%; background: #F27770; }
.wallet-heart::before { top: -5rpx; }
.wallet-heart::after { left: 5rpx; }

/* ====== 纪念日展示 ====== */
.anniversary-display { margin: 20rpx 24rpx 0; padding: 28rpx 30rpx; border-radius: 24rpx; background: linear-gradient(135deg, #FFF3F7, #F2ECFF); box-shadow: 0 6rpx 20rpx rgba(115,79,137,.07); text-align: center; }
.anniversary-display:active { opacity: .78; }
.anniversary-kicker { color: #7D6479; font-size: 25rpx; }
.anniversary-heart { margin-right: 8rpx; color: #FF6B81; font-size: 31rpx; }
.anniversary-days { margin-top: 8rpx; color: #332D36; line-height: 1.1; }
.anniversary-days-number { font-size: 58rpx; font-weight: 750; }
.anniversary-days-unit { margin-left: 8rpx; font-size: 25rpx; font-weight: 500; }
.anniversary-date { margin-top: 9rpx; color: #9A8798; font-size: 22rpx; }
.anniversary-empty { min-height: 48rpx; display: flex; align-items: center; justify-content: center; color: #735E70; font-size: 26rpx; }
.anniversary-arrow { margin-left: auto; color: #B5A5B4; font-size: 34rpx; }

.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.section-heading { display: flex; align-items: center; gap: 12rpx; }
.section-count { color: #9AA0A6; font-size: 22rpx; font-weight: 400; }
.section-link, .more-row, .inline-action { color: #FF607A; font-size: 23rpx; }
.module-state { padding: 28rpx 8rpx; color: #9AA0A6; font-size: 24rpx; text-align: center; }
.module-state.error { color: #C27B31; }
.inline-action { margin-left: 16rpx; }
.today-list { display: flex; flex-direction: column; }
.today-swipe { position: relative; overflow: hidden; border-bottom: 1rpx solid #F1F2F4; }
.today-swipe:last-of-type { border-bottom: none; }
.today-actions { position: absolute; top: 0; right: 0; bottom: 0; display: flex; }
.today-action { width: 112rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24rpx; }
.today-action.edit { background: #8068C7; }
.today-action.delete { background: #E65353; }
.today-item { position: relative; z-index: 1; min-height: 94rpx; display: flex; align-items: center; gap: 10rpx; background: #fff; transition: transform .2s ease; }
.today-item.swiped { transform: translateX(-224rpx); }
.today-item.loading .today-main { opacity: .55; }
.owner-tag { flex-shrink: 0; padding: 4rpx 10rpx; border-radius: 12rpx; font-size: 19rpx; }
.owner-tag { color: #AD4860; background: #FFF0F4; }
.owner-tag.mine { color: #376DAE; background: #EDF5FF; }
.owner-tag.partner { color: #7655A8; background: #F4EFFF; }
.today-time { width: 72rpx; flex-shrink: 0; color: #676E77; font-size: 22rpx; }
.today-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.today-title { overflow: hidden; color: #25282D; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.today-state { margin-top: 3rpx; color: #A6ABB2; font-size: 19rpx; }
.today-state.completed { color: #52A675; }
.more-row { padding-top: 18rpx; text-align: center; }
.bind-card { display: flex; align-items: center; justify-content: space-between; }
.bind-title { color: #616871; font-size: 25rpx; }
.bind-action { color: #FF607A; font-size: 24rpx; }

/* ====== 已绑定状态条 ====== */
.bound-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FFF0F2;
  border-radius: 16rpx;
}
.bound-bar-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
}
.bound-bar-text {
  font-size: 24rpx;
  color: #FF6B81;
  flex: 1;
}

/* ====== 待审批列表 ====== */
.pending-card {
  margin-top: 20rpx;
}
.pending-count {
  display: inline-block;
  background: #F0483E;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.pending-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.pending-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #FFF8F9;
  border-radius: 16rpx;
  border: 1rpx solid #FFE8EA;
}
.pending-item:active {
  opacity: 0.7;
}
.pending-left {
  flex: 1;
  min-width: 0;
}
.pending-location {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pending-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.pending-creator {
  font-size: 24rpx;
  color: #FF6B81;
}
.pending-time {
  font-size: 24rpx;
  color: #9AA0A6;
}

/* ====== Banner 管理弹层 ====== */
.banner-manage-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.banner-manage-panel {
  width: 100%;
  max-height: 75vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.manage-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F0F1F3;
}
.manage-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}
.manage-close {
  font-size: 36rpx;
  color: #9AA0A6;
  padding: 8rpx;
}
.manage-list {
  flex: 1;
  max-height: 55vh;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}
.manage-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F6F7;
}
.manage-item:last-child {
  border-bottom: none;
}
.manage-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F1F3;
}
.manage-item-info {
  flex: 1;
  margin-left: 20rpx;
}
.manage-item-label {
  font-size: 28rpx;
  color: #1F2329;
}
.manage-item-btns {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.manage-btn {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.manage-btn:active {
  opacity: 0.7;
}
.manage-btn-up,
.manage-btn-down {
  background: #F0F1F3;
  color: #5B8FF9;
  font-weight: 600;
}
.manage-btn-del {
  background: #FFF0F2;
  color: #F0483E;
}
.manage-footer {
  padding: 20rpx 32rpx 24rpx;
  border-top: 1rpx solid #F0F1F3;
}
.manage-add-btn {
  text-align: center;
  padding: 20rpx 0;
  background: #FF6B81;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.manage-add-btn:active {
  opacity: 0.85;
}
