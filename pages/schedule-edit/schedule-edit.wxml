<view class="edit-page">
  <view class="state-card" wx:if="{{errorCode}}">
    <text class="state-title">{{errorMessage}}</text>
    <view class="state-action" wx:if="{{errorCode === 'NOT_BOUND' || errorCode === 'BINDING_INVALID'}}" bindtap="onGoBind">去绑定</view>
    <view class="state-action" wx:else bindtap="onRetry">重新加载</view>
  </view>

  <view class="loading-card" wx:elif="{{loading}}">正在加载事项...</view>

  <view wx:else>
    <view class="form-card">
      <view class="field-block">
        <text class="field-label">事项类型</text>
        <view class="type-options">
          <view class="type-option {{type === item.value ? 'active' : ''}}" wx:for="{{types}}" wx:key="value"
            data-type="{{item.value}}" bindtap="onTypeTap">
            <text class="type-name">{{item.label}}</text>
            <text class="type-hint">{{item.hint}}</text>
          </view>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label"><text class="required">*</text>标题</text>
        <input class="text-input" value="{{title}}" maxlength="60" placeholder="例如：一起吃晚饭" bindinput="onTitleInput" />
      </view>

      <view class="field-block">
        <text class="field-label">归属</text>
        <view class="segment-options owner-options">
          <view class="segment-option {{ownerChoice === item.value ? 'active' : ''}}" wx:for="{{ownerOptions}}" wx:key="value"
            data-owner="{{item.value}}" bindtap="onOwnerTap">{{item.label}}</view>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">重复</text>
        <view class="segment-options repeat-options">
          <view class="segment-option {{repeatType === item.value ? 'active' : ''}}" wx:for="{{repeatOptions}}" wx:key="value"
            data-repeat="{{item.value}}" bindtap="onRepeatTap">{{item.label}}</view>
        </view>
        <text class="repeat-edit-hint" wx:if="{{editMode && repeatType !== 'none'}}">修改将影响整个重复事项，已有完成记录会保留</text>
      </view>

      <view class="field-block" wx:if="{{repeatType === 'none'}}">
        <text class="field-label"><text class="required">*</text>日期</text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="picker-row"><text>{{date}}</text><text class="arrow">›</text></view>
        </picker>
      </view>

      <view class="repeat-fields" wx:else>
        <view class="date-range-row">
          <view class="date-range-field">
            <text class="field-label"><text class="required">*</text>循环开始日期</text>
            <picker mode="date" value="{{repeatStartDate}}" bindchange="onRepeatStartChange">
              <view class="picker-row compact"><text>{{repeatStartDate}}</text><text class="arrow">›</text></view>
            </picker>
          </view>
          <view class="date-range-field">
            <text class="field-label"><text class="required">*</text>循环结束日期</text>
            <picker mode="date" value="{{repeatEndDate}}" bindchange="onRepeatEndChange">
              <view class="picker-row compact"><text>{{repeatEndDate}}</text><text class="arrow">›</text></view>
            </picker>
          </view>
        </view>

        <view class="field-block" wx:if="{{repeatType === 'weekly'}}">
          <text class="field-label"><text class="required">*</text>重复星期</text>
          <view class="weekday-options">
            <view class="weekday-option {{item.selected ? 'active' : ''}}" wx:for="{{weekdayOptions}}" wx:key="value"
              data-day="{{item.value}}" bindtap="onWeekdayTap">{{item.label}}</view>
          </view>
          <text class="field-error-hint" wx:if="{{repeatWeekdays.length === 0}}">请至少选择一天</text>
        </view>

        <view class="field-block" wx:if="{{repeatType === 'monthly'}}">
          <text class="field-label"><text class="required">*</text>每月第 X 日</text>
          <view class="monthly-day-row">
            <text>每月第</text>
            <input class="day-input" type="number" maxlength="2" value="{{repeatDay}}" bindinput="onRepeatDayInput" />
            <text>日</text>
          </view>
          <text class="month-skip-hint" wx:if="{{showMonthSkipHint}}">没有该日期的月份将自动跳过</text>
        </view>
      </view>

      <view class="time-row">
        <view class="time-field">
          <text class="field-label">开始时间</text>
          <picker mode="time" value="{{startTime || '09:00'}}" bindchange="onStartTimeChange">
            <view class="picker-row"><text class="{{startTime ? '' : 'placeholder'}}">{{startTime || '不设置'}}</text><text class="arrow">›</text></view>
          </picker>
          <text class="clear-time" wx:if="{{startTime}}" bindtap="onClearStartTime">清除时间</text>
        </view>
        <view class="time-field">
          <text class="field-label">结束时间</text>
          <picker mode="time" value="{{endTime || startTime || '10:00'}}" bindchange="onEndTimeChange">
            <view class="picker-row"><text class="{{endTime ? '' : 'placeholder'}}">{{endTime || '不设置'}}</text><text class="arrow">›</text></view>
          </picker>
          <text class="clear-time" wx:if="{{endTime}}" bindtap="onClearEndTime">清除时间</text>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">备注</text>
        <textarea class="note-input" value="{{note}}" maxlength="500" placeholder="补充地点、准备事项等（选填）" bindinput="onNoteInput" />
        <text class="counter">{{note.length}}/500</text>
      </view>
    </view>

    <view class="stop-button" wx:if="{{editMode && repeatType !== 'none'}}" bindtap="onStopRepeat">{{stopping ? '处理中...' : '停止重复'}}</view>
    <view class="delete-button" wx:if="{{editMode}}" bindtap="onDelete">删除事项</view>
    <view class="bottom-space"></view>
    <view class="save-bar">
      <view class="save-button {{saving ? 'disabled' : ''}}" bindtap="onSave">{{saving ? '保存中...' : '保存'}}</view>
    </view>
  </view>
</view>
