/* pages/detail/detail.wxss —— 详情页样式 */

/* 状态头部 */
.status-header {
  display: flex;
  align-items: center;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
}
.status-header.pending {
  background: #FFF6E5;
}
.status-header.approved {
  background: #E8F8EF;
}
.status-header.rejected {
  background: #FDECEC;
}
.status-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 24rpx;
}
.status-header.pending .status-icon {
  color: #E6A23C;
}
.status-header.approved .status-icon {
  color: #07C160;
}
.status-header.rejected .status-icon {
  color: #F0483E;
}
.status-text {
  font-size: 34rpx;
  font-weight: 700;
}
.status-header.pending .status-text {
  color: #E6A23C;
}
.status-header.approved .status-text {
  color: #07C160;
}
.status-header.rejected .status-text {
  color: #F0483E;
}
.status-sub {
  font-size: 24rpx;
  margin-top: 8rpx;
  color: #9AA0A6;
}

/* 详情信息 */
.detail-row {
  display: flex;
  margin-top: 24rpx;
}
.detail-row:first-child {
  margin-top: 0;
}
.detail-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #9AA0A6;
  font-size: 28rpx;
}
.detail-value {
  flex: 1;
  color: #1F2329;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.detail-row-top {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #F2F3F5;
}

/* 图片 */
.detail-images {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #F2F3F5;
}
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}
.detail-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
}

/* 驳回理由 */
.reject-box {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #FDECEC;
  border-radius: 16rpx;
}
.reject-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #F0483E;
  margin-bottom: 12rpx;
}
.reject-content {
  font-size: 26rpx;
  color: #1F2329;
  line-height: 1.6;
}
.reject-by {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9AA0A6;
  text-align: right;
}

/* 底部审批栏 */
.approve-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(31, 35, 41, 0.06);
}
.approve-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: normal;
}
.approve-btn::after {
  border: none;
}
.approve-btn.pass {
  background: #07C160;
}
.approve-btn.pass.btn-hover {
  background: #06AD56;
}
.approve-btn.reject {
  background: #F0483E;
}
.approve-btn.reject.btn-hover {
  background: #D93A31;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reject-modal {
  width: 85%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.modal-scroll {
  max-height: 80vh;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
  text-align: center;
  margin-bottom: 24rpx;
}
.form-placeholder {
  color: #B8BEC6;
}
.modal-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
}
.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: normal;
}
.modal-btn::after {
  border: none;
}
.modal-btn.cancel {
  background: #F2F3F5;
  color: #1F2329;
}
.modal-btn.confirm {
  background: #F0483E;
  color: #FFFFFF;
}

/* 加载 */
.loading-wrap {
  padding: 200rpx 0;
  text-align: center;
}
.loading-text {
  color: #9AA0A6;
  font-size: 26rpx;
}
