/* pages/bind/bind.wxss —— 绑定页样式 */

.intro-card {
  margin-top: 24rpx;
}
.intro-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2329;
  margin-bottom: 16rpx;
}
.intro-text {
  font-size: 26rpx;
  color: #9AA0A6;
  line-height: 1.6;
}
.intro-step {
  margin-top: 28rpx;
}
.step-line {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFF0F2;
  color: #FF6B81;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.step-text {
  font-size: 26rpx;
  color: #1F2329;
  line-height: 1.6;
  flex: 1;
}

.bind-form {
  margin-top: 24rpx;
}
.form-placeholder {
  color: #B8BEC6;
}
.code-input-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.code-input {
  flex: 1;
  height: 96rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  color: #1F2329;
}
.scan-btn {
  width: 140rpx;
  height: 96rpx;
  background: #FFF0F2;
  color: #FF6B81;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.bind-submit {
  width: 100%;
}
.bind-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #B8BEC6;
  text-align: center;
}
.my-code-card{
  background:#fff8fb;
  text-align:center;
  margin-top:24rpx;
}
.my-code{
  font-size:36rpx;
  font-weight:bold;
  letter-spacing:10rpx;
  color:#ff6b81;
  margin:20rpx 0;
}
.copy-btn{
  width:80%;
  margin:10rpx auto;
}